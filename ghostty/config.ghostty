# ── Theme ────────────────────────────────────────────────
theme = TokyoNight Night

# ── Fonts ────────────────────────────────────────────────
font-family = FiraCode Nerd Font Mono
font-size = 12
font-shaping-break = cursor
adjust-cell-height = 10%

# ── Cursor ───────────────────────────────────────────────
cursor-style = block
cursor-style-blink = true

# ── Mouse / clipboard ────────────────────────────────────
mouse-hide-while-typing = true
copy-on-select = true
clipboard-paste-protection = true

# ── Scrollback ───────────────────────────────────────────
scrollback-limit = 100000000

# ── Window / macOS ───────────────────────────────────────
macos-titlebar-style = transparent
quit-after-last-window-closed = true
confirm-close-surface = false

# ── Window extras ────────────────────────────────────────
window-colorspace = display-p3
background-opacity = 0.95

# ── Notifications ────────────────────────────────────────
desktop-notifications = true

# ── Keybinds ─────────────────────────────────────────────
keybind = global:cmd+grave_accent=toggle_quick_terminal
keybind = shift+enter=text:\x1b\x0d
keybind = ctrl+one=text:\x011
keybind = ctrl+two=text:\x012
keybind = ctrl+three=text:\x013
keybind = ctrl+four=text:\x014
keybind = ctrl+five=text:\x015
keybind = ctrl+six=text:\x016
keybind = ctrl+seven=text:\x017
keybind = ctrl+eight=text:\x018
keybind = ctrl+nine=text:\x019

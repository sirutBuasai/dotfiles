# ~/.ssh/config — portable base for the dotfiles.
#
# Built on the original config's generic defaults. Intentionally does NOT track:
#   • auto-managed corporate SSH proxy blocks (regenerated per machine by tooling);
#   • private/host-specific entries (internal hosts, Kerberos, usernames).
# Keep those in an untracked ~/.ssh/config.local, pulled in below. It's Included
# FIRST so host-specific options win over the Host * defaults (ssh = first match).

Include ~/.ssh/config.local

Host *
  Compression yes
  ServerAliveInterval 15
  ServerAliveCountMax 44
  TCPKeepAlive yes
  AddKeysToAgent yes
  ControlMaster auto
  ControlPath ~/.ssh/cm-%C
  ControlPersist 10m
